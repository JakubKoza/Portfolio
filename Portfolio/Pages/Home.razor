@page "/"
@inject IJSRuntime JSRuntime


<div class="main_top">

		<div class="name">
			<h1>I'm Jakub </h1>
			<h2>Kozłowski</h2>
		</div>

		<div class="subtitle">
			<h2>Student Software Engineer</h2>
		</div>

		<div class="icons">
			<a href="https://github.com/JakubKoza" target="_blank" title="GitHub">
				<i class="ph ph-github-logo"></i>
			</a>

			<a href="https://www.linkedin.com/in/jakub-koz%C5%82owski-2317a62a7/" target="_blank" title="LinkedIn">
				<i class="ph ph-linkedin-logo"></i>
			</a>

			<a href="mailto:jakub32104@gmail.com?subject=Kontakt%20z%20portfolio" target="_top" title="Email">
				<i class="ph ph-envelope-simple"></i>
			</a>
		<a href="#about" class="scroll-down" title="Przewiń w dół">
			<i class="ph ph-caret-double-down"></i>
		</a>
		</div>

	<div class="zakladki">
		<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.NoWrap">
			<RadzenButton Variant="Variant.Outlined" Click=@(args => ScrollTo("educations")) Text="Education" ButtonStyle="ButtonStyle.Base" class="buttonzakladki" />
			<RadzenButton Variant="Variant.Outlined" Click=@(args => ScrollTo("projects")) Text="Projects" ButtonStyle="ButtonStyle.Base" class="buttonzakladki" />
			<RadzenButton Variant="Variant.Outlined" Click=@(args => ScrollTo("Skills")) Text="Skills" ButtonStyle="ButtonStyle.Base" class="buttonzakladki" />
			<RadzenButton Variant="Variant.Outlined" Click=@(args => ScrollTo("contact")) Text="Contact" ButtonStyle="ButtonStyle.Base" class="buttonzakladki" />
		</RadzenStack>
	</div>

</div>

<div class="main">

	<div class="about" id="about">
		<div class="about_content">
			<h3>About Me</h3>
			<p>
				Computer Science student at Częstochowa University of Technology with foundations in C#.
				Constantly expanding knowledge in modern technologies and AI integration.
				Looking for an internship or junior position where I can build useful applications and develop my skills.
			</p>
			<div class="about_passion">
				<i class="ph ph-island" style="font-size:40px"></i>
				<p>
					In free time, I enjoy traveling with my bycycle and exploring new places.
				</p>
			</div>
		</div>
	</div>

	<hr class="przerwa" />

	<div class="educations" id="educations">
		<div class="education_content">
			<div class="edu_left">
				<h3>Educations</h3>
			</div>
			<div class="edu_right">

				<h4>Computer Science</h4>
				<div class="edu_details">
					<em>Częstochowa University of Technology</em>
					<i class="ph ph-student"></i>
					2024 - CURRENT
				</div>

				<h4>IT Technician</h4>
				<div class="edu_details">
					<em>Technical High School in Szczerców</em>
					<i class="ph ph-student"></i>
					2019 - 2024
				</div>

			</div>
		</div>
	</div>

	<hr class="przerwa" />

	<div class="projects" id="projects">
		<h3>Projects</h3>

		<div class="projects-track">
			<!-- Karta 1: ProjectBike -->
			<div class="project-card">
				<h4>ProjectBike <span class="badge-main">MAIN</span> </h4>
				<p>A desktop application for managing a bicycle rental shop. Built in C# and .NET WPF using the MVVM architecture and the Repository and Unit of Work patterns</p>
				<div class="project-links">
					<a href="https://github.com/JakubKoza/ProjectBike_My" target="_blank" style="text-decoration: none;">
						<RadzenButton Variant="Variant.Outlined" Text="GitHub" ButtonStyle="ButtonStyle.Base" class="buttongithub" />
					</a>
				</div>
			</div>

			<!-- Karta 2: Telegram Scraper -->
			<div class="project-card">
				<h4>Telegram Scraper</h4>
				<p>A web scraper written in Python and hosted on a NAS server via Docker. It automatically monitors bicycle listings and sends notifications to a Telegram messenger.</p>
				<div class="project-links">
					<!--<a href="TUTAJ_WKLEJ_LINK_DO_GITHUB" target="_blank" style="text-decoration: none;">-->
					<RadzenButton Variant="Variant.Outlined" Text="GitHub" ButtonStyle="ButtonStyle.Base" class="buttongithub" />
				<!--</a>-->
				</div>
			</div>

			<!-- Karta 3: Portfolio -->
			<div class="project-card">
				<h4>Working Progress...</h4>
				<p></p>
				<div class="project-links">	
					<RadzenButton Variant="Variant.Outlined" Text="GitHub" ButtonStyle="ButtonStyle.Base" class="buttongithub" />
				</div>
			</div>
		</div>
	</div>

	<hr class="przerwa" />

	<div class="skills" id="skills">
		<h3>Skills & Certificates</h3>

		<!-- Wyśrodkowany przycisk pobierania CV -->
		<div class="cv-download">
			<!-- Tutaj w href podasz ścieżkę do pliku PDF, np. "files/CV_Jakub_Kozlowski.pdf" -->
			<a href="#" target="_blank" download style="text-decoration: none;">
				<RadzenButton Variant="Variant.Outlined" Text="Download CV" ButtonStyle="ButtonStyle.Base" class="buttoncv" />
			</a>
		</div>

		<!-- Siatka 2x1 -->
		<div class="skills-grid">
			<!-- Lewy kwadrat: Technologie -->
			<div class="skill-card">
				<h4><i class="ph ph-code"></i> Technical Skills</h4>
				<div class="tech-stack-large">
					<span>C#</span>
					<span>.NET (WPF, Blazor, MVVM)</span>
					<span>C++</span>
					<span>x86/x64 Assembly</span>
					<span>Python</span>
					<span>SQL</span>
					<span>Linux</span>
					<span>Polish Native</span>
					<span>English B2</span>
				</div>
			</div>

			<!-- Prawy kwadrat: Certyfikaty -->
			<div class="skill-card">
				<h4><i class="ph ph-certificate"></i> Certificates</h4>
				<ul class="cert-list">
					<li>
						<h2>INF.02 & INF.03</h2>
						<span>IT Technician Vocational Qualifications <a href="">PDF</a></span>
					</li>
					<li>
						<h2>Google</h2>
						<span>AI Curse - Umiejętności Jutra 3.0 <a href="">PDF</a></span>
					</li>
					<li>
						<h2>Sekurak</h2>
						<span>Short Cybersecurity training <a href="">PDF</a></span>
					</li>
					<li>
						<h2>UDT & IMBiGS</h2>
						<span>Telehandlers & Boom Lifts Operator</span>
						<span>Class 1 Wheel loader</span>
					</li>
					<li>
						<h2>Driver's License</h2>
						<span>Category B </span> 
					</li>
				</ul>

			</div>
		</div>
	</div>


</div>

@code {
	private async Task ScrollTo(string id)
	{
		await JSRuntime.InvokeVoidAsync("scrollToElementId", id);
	}

}

